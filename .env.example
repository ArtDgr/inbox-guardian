# HEADLESS — no laptop required. Fill these as container / hosting secrets (never commit .env)
# Azure App Registration (Application permissions, NOT delegated)
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=super-secret-from-certificates-and-secrets
AUTH_MODE=client_credentials
# Mailbox to monitor (UPN). For shared mailbox use shared@domain.com. Must be in same tenant.
MAILBOX_UPN=you@company.com

# Behaviour
ALLOW_WRITE=false
API_KEY=change-me-strong-random-32-chars  # protects GET /highlights and POST /trigger when hosted
TEAMS_WEBHOOK_URL=

# LLM — headless uses OpenAI (no Ollama on server). Leave blank to use heuristics only.
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Alternative for personal Outlook.com (no tenant admin): after one-time local bootstrap, paste refresh token here
# Then AUTH_MODE=delegated + MS_REFRESH_TOKEN + AZURE_CLIENT_ID (public app)
# MS_REFRESH_TOKEN=

# Hosting
PORT=8000
GRAPH_API_BASE=https://graph.microsoft.com/v1.0
