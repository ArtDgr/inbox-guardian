# suckityouhackers@outlook.com — HEADLESS personal Outlook.com
# Personal mailboxes cannot use client_credentials (needs admin). Use delegated + refresh_token.
# 1) Create App Registration once (portal.azure.com -> App registrations -> New)
#    Name: Inbox Guardian Personal | Supported: Any org + personal | Type: Public client (no secret)
#    API perms Delegated: Mail.Read, Mail.ReadWrite, MailboxSettings.Read, offline_access -> Grant consent for yourself
#    Copy Application (client) ID below.
# 2) Bootstrap once locally: $env:ALLOW_DEVICE_FLOW="true"; py bootstrap_refresh_token.py
#    Paste the printed MS_REFRESH_TOKEN here, then deploy headless — no laptop afterwards.

AZURE_CLIENT_ID=PASTE-YOUR-APP-CLIENT-ID-HERE
AZURE_TENANT_ID=common
AUTH_MODE=delegated
MAILBOX_UPN=suckityouhackers@outlook.com
MS_REFRESH_TOKEN=PASTE-FROM-BOOTSTRAP-HERE

ALLOW_WRITE=false
API_KEY=change-me-32-char-random-for-highlights-endpoint
TEAMS_WEBHOOK_URL=

# Headless LLM (no Ollama in cloud) — heuristics work without this; set for smarter scoring
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

PORT=8000
